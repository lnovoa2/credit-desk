<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="BatchIntervalSeconds" value="15" />
    <add key="HighRiskScore" value="72" />
    <add key="ManualReviewAmount" value="7500" />
    <add key="HardBlockOverdueDays" value="90" />
    <add key="LegacyCountrySurcharge" value="PT,IT,GR" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.0">
      <assemblies>
        <add assembly="Mono.Data.Sqlite, Version=4.0.0.0, Culture=neutral, PublicKeyToken=0738eb9f132ed756" />
      </assemblies>
    </compilation>
    <customErrors mode="Off" />
    <httpRuntime targetFramework="4.0" />
    <pages validateRequest="false" />
  </system.web>
</configuration>
